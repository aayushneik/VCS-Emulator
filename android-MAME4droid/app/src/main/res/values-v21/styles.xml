<?xml version="1.0" encoding="utf-8"?>

<resources>

	<style name="ListText">
		<item name="android:textSize">26sp</item>
		<item name="android:textColor">@color/white</item>
	</style>

	<style name="ListTextSmall">
		<item name="android:textSize">18sp</item>
		<item name="android:textColor">@color/white</item>
	</style>


    <style name="Theme.MAME4droid" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:colorPrimary">@color/premium_primary</item>
        <item name="android:colorAccent">@color/premium_accent</item>
        <item name="android:textColorPrimary">@color/premium_text</item>
        <item name="android:textColorSecondary">@color/premium_text_dim</item>
        <item name="android:alertDialogTheme">@style/Theme.MAME4droid.Dialog</item>
        <item name="android:dialogTheme">@style/Theme.MAME4droid.Dialog</item>
    </style>

    <style name="Theme.MAME4droid.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/premium_dialog_bg</item>
        <item name="android:colorAccent">@color/premium_accent</item>
        <item name="android:textColorPrimary">@color/premium_text</item>
        <item name="android:textColorSecondary">@color/premium_text_dim</item>
    </style>

    <style name="Theme.MAME4droid.DialogActivity" parent="android:Theme.Material.Dialog">
        <item name="android:windowBackground">@drawable/premium_dialog_bg</item>
        <item name="android:colorAccent">@color/premium_accent</item>
        <item name="android:textColorPrimary">@color/premium_text</item>
        <item name="android:textColorSecondary">@color/premium_text_dim</item>
    </style>

    <style name="PremiumWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/premium_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/premium_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/premium_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/premium_pop_exit</item>
    </style>

    <style name="Theme.MAME4droid.TitleBar" parent="android:Theme.Material.NoActionBar.Fullscreen">

        <item name="android:windowNoTitle">false</item>
        <item name="android:windowBackground">@color/premium_bg</item>
        <item name="android:colorPrimary">@color/premium_primary</item>
        <item name="android:colorPrimaryDark">@color/premium_primary_dark</item>
        <item name="android:colorAccent">@color/premium_accent</item>
        <item name="android:textColorPrimary">@color/premium_text</item>
        <item name="android:textColorSecondary">@color/premium_text_dim</item>
        <item name="android:navigationBarColor">@color/premium_bg</item>
        <item name="android:windowAnimationStyle">@style/PremiumWindowAnimation</item>

    </style>
    
</resources>